FoamFile
{
    version     2.0;
    format      ascii;
    class       areaVectorField;
    location    "0/finite-area";
    object      rigidBed;
}

// The initial mobile sediment layer is 0.05 m thick: bed z=0, rigid z=-0.05.
dimensions    [0 1 0 0 0 0 0];
internalField uniform (0 0 -0.05);

boundaryField
{
    inletFa
    {
        type zeroGradient;
    }
    outletFa
    {
        type zeroGradient;
    }
    sideWallsFa
    {
        type zeroGradient;
    }
    defaultFa
    {
        type zeroGradient;
    }
}
