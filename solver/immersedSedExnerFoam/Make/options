/* 中文说明：声明编译求解器所需的 OpenFOAM 头文件路径和链接库。 */
sinclude $(GENERAL_RULES)/module-path-user

/* Failsafe - user location */
ifeq (,$(strip $(FOAM_MODULE_APPBIN)))
    FOAM_MODULE_APPBIN = $(FOAM_USER_APPBIN)
endif
ifeq (,$(strip $(FOAM_MODULE_LIBBIN)))
    FOAM_MODULE_LIBBIN = $(FOAM_USER_LIBBIN)
endif

EXE_INC = \
    -DOFVERSION=$(OF_VERSION) \
    -I../buoyantBoussinesqSimpleFoam \
    -I../../incompressible/pimpleFoam \
    -I$(LIB_SRC)/sampling/lnInclude \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/finiteArea/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/dynamicMesh/lnInclude \
    -I$(LIB_SRC)/dynamicFvMesh/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/TurbulenceModels/turbulenceModels/lnInclude \
    -I$(LIB_SRC)/TurbulenceModels/incompressible/lnInclude \
    -I$(LIB_SRC)/transportModels \
    -I$(LIB_SRC)/transportModels/incompressible/singlePhaseTransportModel \
    -I$(LIB_SRC)/thermophysicalModels/radiation/lnInclude \
    -I$(WM_PROJECT_USER_DIR)/applications/solvers/sedExnerFoam/src/settlingModels/lnInclude \
    -I$(WM_PROJECT_USER_DIR)/applications/solvers/sedExnerFoam/src/criticalShieldsModels/lnInclude \
    -I$(WM_PROJECT_USER_DIR)/applications/solvers/sedExnerFoam/src/bedloadModels/lnInclude \
    -I$(WM_PROJECT_USER_DIR)/applications/solvers/sedExnerFoam/src/sedimentBed/lnInclude \
    -I$(WM_PROJECT_USER_DIR)/applications/solvers/sedExnerFoam/src/projectedFiniteArea/lnInclude \
    -I$(LIB_SRC)/sixDoFRigidBodyMotion/lnInclude

EXE_LIBS = \
    -L$(FOAM_USER_LIBBIN) \
    -lsettlingModels \
    -lcriticalShieldsModels \
    -lbedloadModels \
    -lsedimentBed \
    -lprojectedFiniteArea \
    -lfiniteVolume \
    -lfiniteArea \
    -lfvOptions \
    -lmeshTools \
    -ldynamicMesh \
    -ldynamicFvMesh \
    -ltopoChangerFvMesh \
    -lsixDoFRigidBodyMotion \
    -lsampling \
    -lturbulenceModels \
    -lincompressibleTurbulenceModels \
    -lincompressibleTransportModels
    
