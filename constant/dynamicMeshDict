// 中文说明：指定动态网格类型和床面位移求解器，用于随冲淤移动体网格。
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}

dynamicFvMesh dynamicMotionSolverFvMesh;
motionSolverLibs ("libfvMotionSolvers.so");
solver displacementLaplacian;

displacementLaplacianCoeffs
{
    // Concentrate mesh deformation near the movable bed.
    // Quadratic inverse-distance diffusion moves near-bed layers together and
    // transfers the remaining deformation smoothly towards the fixed lid.
    diffusivity quadratic inverseDistance 1(bed);
}
