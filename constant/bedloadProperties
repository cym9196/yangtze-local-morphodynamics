// 中文说明：推移质、临界 Shields、床坡修正、雪崩和 Exner 稳定限制参数。
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      bedloadProperties;
}

// Activate the Exner sediment-bed model on patch bed.
sedimentBed        on;
bedMotion          on;
sedimentBedPatches (bed);

// First-order explicit update is conservative for the initial coarse test.
ABorder 0;

// Hold bed elevation only at the outer flume perimeter. The immersed solid
// does not create a hole or an artificial fixed line in the finite-area bed.
fixedFaPatches (inletFa outletFa sideWallsFa);

bedloadModel
{
    type            MeyerPeter;
    slopeCorrection on;

    avalanche       on;
    Qav             1e-3;
    NfiltBeta       1;
    alphaFiltBeta   0.1;
    onEdge          off;

    // Physical baseline: no artificial multiplication of bed shear stress.
    coefShields     1;
}

criticalShieldsModel
{
    type            Soulsby;
    slopeCorrection on;
}

// One CFD second equals one physical second.
morphoAccFactor 1;

// Explicit Exner stability guard: at most 0.1% of a 1 mm cell per CFD step.
maxBedChangePerStep 1e-6;

// The second cap is proportional to deltaT, so adaptive time-step collapse
// cannot turn a small displacement into an unbounded dynamic-mesh velocity.
maxBedChangeRate 2.5e-4;

// Smooth only the per-step Exner increment.  The neighbour exchanges are
// equal and opposite in sediment volume, so accumulated bed mass is retained.
filterExner      off;
alphaFiltExner  0.5;
NfiltExner      4;

// Absolute accumulated-bed guards.  maxBedSlope=0.55 (28.8 degrees) stays
// below the 32 degree repose angle, leaving headroom for point interpolation.
maxBedSlope                0.55;
maxBedPointCurvature       1e-4;
maxBedRegularisationRate   1e-2;
bedSurfaceLimiterPasses    4;
bedSurfaceRepairPasses     64;

// A rigid layer is 0.05 m below the initial bed (defined in rigidBed).
rigidBed on;
